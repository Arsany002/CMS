# Development artefacts — excluded from the Docker build context
vendor/
node_modules/

# Secrets & local config (injected via env at runtime)
.env
.env.*
!.env.example

# Passport keys (generated at container startup)
storage/*.key

# Runtime-generated content
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*

# Tests (not needed in the image)
tests/
phpunit.xml
phpunit.xml.dist

# Dev tooling / docs
.git
.github
.gitignore
*.md
docs/
codebase.md
_ide_helper.php
_ide_helper_models.php

# Build / CI artefacts
backend-build.log
*.log
